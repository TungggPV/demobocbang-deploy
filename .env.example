# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=
# Persistence and security
REDIS_URL=
QUEUE_BACKEND=redis
WORKER_MAX_RETRIES=3
WORKER_RETRY_MIN_BACKOFF_MS=10000
WORKER_RETRY_MAX_BACKOFF_MS=60000
WORKER_RECONCILE_INTERVAL_SECONDS=15
WORKER_RECONCILE_BATCH_SIZE=100
WORKER_DELIVERY_TIMEOUT_SECONDS=300
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Authentication policy
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5

# Google OAuth
# Create a "Web application" OAuth client in Google Cloud.  This exact URL
# must also be listed under that client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Email delivery
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_ATTACHMENT_MAX_BYTES=15000000

# Object storage. Local is for development/tests only; production buckets stay private.
STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=.local-media
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=auto
# STORAGE_PRESIGNED_URL_TTL_SECONDS=300

# Speech-to-text (AssemblyAI)
STT_PROVIDER=assemblyai
STT_API_KEY=
STT_MODEL=universal-3-5-pro
STT_FALLBACK_MODEL=universal-2
ASSEMBLYAI_API_BASE_URL=https://api.assemblyai.com/v2
ASSEMBLYAI_STREAMING_BASE_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_STREAMING_MODEL=universal-3-6-pro
ASSEMBLYAI_STREAMING_MODE=max_accuracy
ASSEMBLYAI_STREAMING_MIN_TURN_SILENCE_MS=560
ASSEMBLYAI_STREAMING_MAX_TURN_SILENCE_MS=2000
STT_POLL_INTERVAL_SECONDS=2
STT_POLL_TIMEOUT_SECONDS=1800
# Translation (Gemini)
TRANSLATION_PROVIDER=gemini
TRANSLATION_API_KEY=
# Optional translation fallback: called only when Gemini returns a provider error.
# TRANSLATION_FALLBACK_PROVIDER=groq
# Summaries (Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional summary fallback: called only when the primary LLM provider fails.
# LLM_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1


# Media limits
MAX_UPLOAD_BYTES=524288000
MAX_MEDIA_DURATION_SECONDS=7200

# Public frontend endpoints
# Compose uses these as frontend build arguments (blank = localhost defaults).
# Rebuild with docker compose up --build -d after changing frontend values.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
